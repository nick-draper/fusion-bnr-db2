# Values for the manifests. Copy this file to .env, fill it in, then run:
#   ./scripts/render.sh
# which writes ready-to-apply manifests to build/, plus build/env.sh with the
# namespace names for the commands in docs/end-to-end.md. The script only
# writes files; it never talks to a cluster. .env and build/ are git-ignored.
#
# One KEY=value per line. Quotes around a value are optional.

# Namespaces
FUSION_NS=ibm-spectrum-fusion-ns
OP_NS=db2-operator
SOURCE_NS=db2u-instance
TARGET_NS=db2u-instance-dev
HELPER_NS=recipe-helper

# Db2uInstance
DB2_LICENSE=
STORAGE_CLASS=isf-block-file-delete-sc

# Object storage (docs/object-storage-setup.md)
S3_BUCKET_NAME=db2u-instance-bucket
S3_ENDPOINT=https://s3.my.cluster:9200
# Required by the S3 client; MinIO ignores the value.
S3_REGION=us-west-2
# The access key pair for the bucket user. S3_ACCESS_KEY is the secret key.
S3_ACCESS_KEY_ID=
S3_ACCESS_KEY=
